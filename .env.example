# AI Orchestrator 환경 변수 예시
# 실제 값은 .env.local 에 작성하며 저장소에 커밋하지 않는다.
# (.gitignore 에서 .env.local 은 제외됨)

# GitHub 작업 큐 연동 (읽기 전용, GET /api/work-queue)
# Fine-grained PAT 또는 GitHub App 토큰. Issues/PR 읽기·쓰기 권한 필요.
GITHUB_TOKEN=
GITHUB_REPO=jonghee1998/ai-orchestrator

# 에이전트 연결 (후속 단계에서 정의)
# 구독 기반 CLI 인증은 로컬 머신의 자격 증명을 사용하며 여기에 저장하지 않는다.

# Phase 5 (docs/PHASE5.md) — 값은 .env.local / 배포 비밀로만 설정
# DATABASE_URL=            # 운영 Postgres (서버리스 필수)
# RUN_STORE_PATH=          # 단일 프로세스 개발용 파일 스토어
# CONTROL_ADMIN_TOKEN=     # 16자 이상
# CONTROL_READ_TOKEN=      # 16자 이상
# Issue #23 추가
# CRON_SECRET=             # 16자 이상. GET /api/reconcile (Vercel Cron Bearer)
# DATABASE_SSL_CA=        # 공급자 CA(PEM, 줄바꿈은 \n 가능). TLS 검증은 유지한 채 Supabase 풀러 등 신뢰 CA 추가
# DATABASE_SSL=            # 로컬 비-SSL Postgres 테스트에서만 'disable'
# TEST_DATABASE_URL=       # 설정 시 pg-store 통합 테스트 실행
# Issue #31
# GITHUB_READ_TOKEN=      # 읽기 전용(Issues: read) fine-grained PAT 권장. 없으면 GITHUB_TOKEN으로 읽음(최소권한 미충족으로 표시됨)

# #34 — 에이전트별 고유 서명 비밀 (게이트 /api/gate + 콜백 /api/runs/callback). ≥32자, 에이전트 간 공유 금지.
# provider 공용 값(RUN_CALLBACK_SECRET_CLAUDE 등)은 더 이상 사용되지 않음.
# RUN_CALLBACK_SECRET_CLAUDE_SONNET=
# RUN_CALLBACK_SECRET_CLAUDE_OPUS=
# RUN_CALLBACK_SECRET_CODEX=
# RUN_CALLBACK_SECRET_GPT=
# #55 routine-session channel (docs/SESSION_AUTH.md): sha256 hex of the per-agent token ONLY (never the token).
# The token itself lives in that agent's Claude environment Network Secret header x-orch-session-token.
# SESSION_TOKEN_SHA256_CLAUDE_SONNET=
# SESSION_TOKEN_SHA256_CLAUDE_OPUS=

# #85 세션 (docs/DASHBOARD_USABILITY.md)
# CONTROL_SESSION_EPOCH=1   # 값을 바꾸면 발급된 모든 로그인 세션이 폐기됨

# 단일 관리자 로그인 (#87). 기본 계정/비밀번호 없음. 설정법: docs/ADMIN_LOGIN.md
ADMIN_USERNAME=
# scripts/hash-admin-password.mjs 로 생성한 scrypt 해시. 평문 비밀번호 금지.
# .env.local 에서는 모든 $를 \$로 이스케이프한다 (따옴표만으로는 부족).
ADMIN_PASSWORD_HASH=
# CONTROL_ADMIN_TOKEN 은 서버 내부 서명/기존 API 용도로 계속 필요. 브라우저 입력 금지.

# 오케스트레이터 엔진 상황판 (docs/ORCH_MANUAL.md 10장)
# 상황판이 보여줄 저장소 목록 (쉼표 구분). 비우면 GITHUB_REPO 하나만.
# ORCH_REPOS=jonghee1998/ai-orchestrator,jonghee1998/orch-sandbox
# Fine-grained PAT (위 저장소들): Issues Read and write, Variables Read and write, Actions Read and write.
# Issues: Read and write 필요(계획 승인·아이디어 등록), 토큰 주인이 저장소 소유자여야 등록한 아이디어가 화면에 보임.
# 없으면 읽기만 GITHUB_READ_TOKEN/GITHUB_TOKEN으로 하고 ON/OFF 스위치는 비활성.
# ORCH_GITHUB_TOKEN=
